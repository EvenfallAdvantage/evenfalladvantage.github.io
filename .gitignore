# Environment variables
.env
.env.local
.env.*.local
.env.staging

# API Keys and Secrets
*.key
*.pem

# Node modules
node_modules/

# Next.js build artifacts (overwatch-src)
overwatch-src/.next/
overwatch-src/out/
overwatch-src/.env
overwatch-src/.env.local
overwatch-src/public/cesium/

# Overwatch build output: built and deployed by .github/workflows/deploy.yml
# (Pages source = GitHub Actions). Never commit it; a committed copy gets served
# by the legacy branch build and shows stale code after each push.
/overwatch/

# Database backups (NEVER commit to public repo)
backups/
*.dump

# Audit clone (nested repo)
audit-clone/

# Binary executables
*.exe

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
